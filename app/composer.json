{
    "name": "pablo/pablo",
    "description": "PABLO - Personal Assistant for Boring Logic & Operations. AI orchestrator for OpenCode/Orca-managed projects.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Pablo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pablo\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-phar": "*",
        "ext-zlib": "*",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/process": "^8.1",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-chartjs": "^3.7",
        "symfony/ux-icons": "^3.7",
        "symfony/ux-live-component": "^3.7",
        "symfony/ux-twig-component": "^3.7",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "suggest": {
        "ext-pcntl": "Lets pablo web pass a service stop (SIGTERM/SIGINT) on to its php -S workers",
        "ext-posix": "Native pid and user lookups (headless agent liveness, scheduler uid/user name); without it PABLO falls back to kill -0 and id"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
