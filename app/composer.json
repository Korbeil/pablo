{
    "name": "pablo/pablo",
    "description": "PABLO - Personal Assistant for Boring Logic & Operations. AI orchestrator for OpenCode/Orca-managed projects.",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Pablo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pablo\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "symfony/asset-mapper": "^8.1",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.1",
        "symfony/process": "^8.0",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-icons": "^3.4",
        "symfony/ux-live-component": "^3.4",
        "symfony/ux-twig-component": "^3.4",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
