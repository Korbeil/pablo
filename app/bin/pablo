#!/usr/bin/env php
<?php

declare(strict_types=1);

use Pablo\App\ConsoleApplication;
use Pablo\App\Kernel;

/**
 * PABLO — AI orchestrator. The user-facing CLI.
 *
 * Two ways to run it, same code:
 *  - the standalone binary (~/.local/bin/pablo), built from this file by Box
 *    (app/box.json) and combined with a static PHP: PABLO_ENV defaults to
 *    `prod`, the container is cached under ~/.pablo/cache/container/<version>
 *    (see Kernel::getCacheDir());
 *  - `php app/bin/pablo` from a repository checkout (contributors): PABLO_ENV
 *    defaults to `dev`, NOT `prod` — in prod the container cache is never
 *    checked for freshness, so a `git pull` would leave a stale container
 *    forever.
 *
 * It runs from other repositories' worktrees (cwd is used verbatim). Boots the
 * same kernel as the dashboard but runs ConsoleApplication, which consumes the
 * `pablo.command` tag — so `pablo --help` lists PABLO subcommands only.
 */

require __DIR__ . '/../vendor/autoload.php';

$env = Kernel::defaultEnvironment();

$kernel = new Kernel($env, 'prod' !== $env);
$kernel->boot();

$application = $kernel->getContainer()->get(ConsoleApplication::class);
\assert($application instanceof ConsoleApplication);

exit($application->run());
