<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.result.cache">
    <php>
        <!-- KernelTestCase/WebTestCase need this: there is no .env, so APP_ENV
             is unset and defaults to test. -->
        <server name="KERNEL_CLASS" value="Pablo\App\Kernel"/>
        <!-- Every test kernel boots with debug on: only a debug kernel checks
             its cached container (var/cache/test) for freshness, so a rebase
             that changes a service's constructor rebuilds it instead of
             failing on a stale one. An env (read before $_SERVER by
             KernelTestCase), forced so an APP_DEBUG=0 in the shell cannot turn
             the check off. -->
        <env name="APP_DEBUG" value="1" force="true"/>
        <!-- Pin the Orca CLI name (orca-ide on Linux, orca elsewhere) so the
             tests read the same on every OS. OrcaCliTest unsets it. -->
        <env name="ORCA_CLI_COMMAND" value="orca" force="true"/>
    </php>
    <testsuites>
        <testsuite name="pablo">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
