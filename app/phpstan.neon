parameters:
    level: 8
    paths:
        - src
        - tests
        - config
        - public
    excludePaths:
        analyse:
            - var
            # Auto-generated by Symfony on cache warm, purely for IDE
            # autocompletion of config(). It type-hints optional components we
            # do not install (e.g. ExpressionLanguage), so analysing it is a
            # hard error rather than a finding. The (?) marker makes the entry
            # optional on a fresh checkout where it has not been generated yet.
            - config/reference.php (?)
    tmpDir: var/cache/phpstan
    bootstrapFiles:
        - vendor/autoload.php
