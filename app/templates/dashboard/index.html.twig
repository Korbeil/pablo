{% extends 'base.html.twig' %}

{% block title %}PABLO dashboard{% endblock %}

{% block body %}
    <header class="pablo-header">
        <div class="pablo-container pablo-header-inner">
            <a class="pablo-brand" href="{{ path('dashboard') }}">
                <img class="pablo-logo" src="{{ asset('images/logo-light.svg') }}" alt="PABLO" width="125" height="42">
                <span class="pablo-page-tag">Dashboard</span>
            </a>
            <h1 class="pablo-visually-hidden">P.A.B.L.O. — Personal Assistant for Boring Logic &amp; Operations</h1>
            <div class="pablo-header-actions">
                <twig:ThemeToggle />
                <twig:SlackModal />
                <a class="button pablo-header-btn" href="{{ path('analytics') }}" title="Analytics" aria-label="Analytics">
                    {{ ux_icon('lucide:chart-column', {class: 'pablo-icon'}) }}
                    <span class="pablo-btn-label">Analytics</span>
                </a>
                <twig:NewTaskModal />
            </div>
        </div>
    </header>

    <main class="pablo-container">
        <twig:DispatchHealthBanner />
        <twig:TaskActionsModal />
        {% if project_errors is not empty %}
            <div class="notification is-danger is-light pablo-section" role="alert">
                {{ ux_icon('lucide:triangle-alert', {class: 'pablo-icon'}) }}
                <strong>Invalid project config — {{ project_errors|length > 1 ? 'these projects are' : 'this project is' }} skipped by dispatch and missing below:</strong>
                <ul>
                    {% for file, error in project_errors %}
                        <li><code>{{ file }}</code>: {{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        <twig:TaskBoard />

        <section class="pablo-section">
            <h2 class="pablo-heading">
                {{ ux_icon('lucide:clock', {class: 'pablo-icon'}) }}
                Poller
            </h2>
            <twig:PollProgress />
        </section>

        <section class="pablo-section">
            <h2 class="pablo-heading">
                {{ ux_icon('lucide:refresh-cw', {class: 'pablo-icon'}) }}
                Last sync
            </h2>
            <twig:RebaseLog />
        </section>
    </main>
{% endblock %}
