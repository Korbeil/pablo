{# @var this \Pablo\Twig\Components\TaskBoard #}
<div {{ attributes.defaults({'data-poll': 'delay(' ~ constant('Pablo\\Twig\\Components\\TaskBoard::POLL_MS') ~ ')|$render'}) }}>

    <section class="pablo-section">
        <h2 class="pablo-heading">
            {{ ux_icon('lucide:message-circle', {class: 'pablo-icon'}) }}
            Waiting for feedback
            {% if this.attention|length %}
                <span class="tag is-danger is-rounded">{{ this.attention|length }}</span>
            {% endif %}
        </h2>
        <twig:TaskTable :tasks="this.attention" empty="Nothing is waiting on you right now 🎉" />
    </section>

    <section class="pablo-section">
        <h2 class="pablo-heading">
            {{ ux_icon('lucide:git-branch', {class: 'pablo-icon'}) }}
            Other tasks
            {% if this.rest|length %}
                <span class="tag pablo-chip is-rounded">{{ this.rest|length }}</span>
            {% endif %}
        </h2>
        <twig:TaskTable :tasks="this.rest" empty="No other active tasks." />
    </section>
</div>
