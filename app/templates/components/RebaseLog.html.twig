{# @var this \Pablo\Twig\Components\RebaseLog #}
<div {{ attributes.defaults({'data-poll': 'delay(' ~ constant('Pablo\\Twig\\Components\\RebaseLog::POLL_MS') ~ ')|$render'}) }}>
    {% set logs = this.logs %}
    {% if logs is empty %}
        <p class="pablo-empty">No sync has run yet — try <code>pablo sync:run &lt;project&gt;</code>.</p>
    {% else %}
        <div class="pablo-logs">
            {% for section in logs %}{% set log = section.log %}
                <div class="box pablo-log">
                    <div class="pablo-log-head">
                        <span class="pablo-log-project">{{ log.project }}</span>
                        <span class="tag pablo-chip">{{ log.strategy }}</span>
                        {% if log.timestamp %}
                            <span class="pablo-log-time" title="{{ log.timestamp }}">
                                {{ ux_icon('lucide:clock', {class: 'pablo-icon pablo-icon-dim'}) }}
                                {{ log.timestamp|date('d M H:i') }}
                            </span>
                        {% endif %}
                    </div>

                    {% if section.rows is empty %}
                        <p class="pablo-empty">No task worktrees to sync.</p>
                    {% else %}
                        <ul class="pablo-log-list">
                            {% for r in section.rows %}
                                <li class="pablo-log-row">
                                    <span class="tag {{ r.color }}">
                                        {{ ux_icon(r.icon, {class: 'pablo-icon'}) }}
                                        <span>{{ r.label }}</span>
                                    </span>

                                    <code class="pablo-log-branch">{{ r.report.branch }}</code>

                                    {% if r.report.behind or r.report.ahead %}
                                        <span class="pablo-log-counts">
                                            behind {{ r.report.behind }} · ahead {{ r.report.ahead }}
                                        </span>
                                    {% endif %}

                                    {% if r.report.detail and r.report.action != 'conflict' %}
                                        <span class="pablo-log-detail">{{ r.report.detail }}</span>
                                    {% endif %}

                                    {% if r.report.conflictFiles %}
                                        <ul class="pablo-conflicts">
                                            {% for f in r.report.conflictFiles %}
                                                <li><code>{{ f }}</code></li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}

                                    {% if r.report.agentHandle %}
                                        <div class="pablo-log-agent">
                                            {{ ux_icon('lucide:activity', {class: 'pablo-icon pablo-icon-dim'}) }}
                                            fix agent running —
                                            <code>opencode -s {{ r.report.agentHandle }}</code>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
