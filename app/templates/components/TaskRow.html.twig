{# @var task \Pablo\Dashboard\TaskView #}
<tr>
    <td class="pablo-nowrap pablo-cell-project">
        <span class="has-text-grey">{{ task.project }}</span>
    </td>

    <td class="pablo-cell-task">
        <div class="pablo-branch">
            {{ ux_icon('lucide:git-branch', {class: 'pablo-icon pablo-icon-dim'}) }}
            <code>{{ task.branch }}</code>
        </div>
        <div class="pablo-label">
            {% if task.issue %}
                <a href="{{ task.issue.url }}" target="_blank" rel="noopener">{{ task.issue.key }}</a>
                {{ task.issue.title }}
            {% elseif task.summary %}
                {{ task.summary }}
            {% else %}
                <span class="has-text-grey-light">—</span>
            {% endif %}
        </div>
    </td>

    <td class="pablo-cell-state"><twig:StateBadge :task="task" /></td>

    <td class="pablo-nowrap pablo-cell-agents">
        {% if task.agents.total == 0 %}
            <span class="has-text-grey-light">—</span>
        {% else %}
            {% if task.agents.running %}
                <span class="tag pablo-chip" title="{{ task.agents.running }} agent(s) running">
                    {{ ux_icon('lucide:activity', {class: 'pablo-icon'}) }} {{ task.agents.running }}
                </span>
            {% endif %}
            {% if task.agents.waiting %}
                <span class="tag is-warning" title="{{ task.agents.waiting }} agent(s) waiting for you">
                    {{ ux_icon('lucide:message-circle', {class: 'pablo-icon'}) }} {{ task.agents.waiting }}
                </span>
            {% endif %}
        {% endif %}
    </td>

    <td class="pablo-nowrap pablo-cell-tracker">
        {% if task.trackerStatus %}
            {% if task.issue %}
                <a class="tag pablo-chip pablo-state" href="{{ task.issue.url }}" target="_blank" rel="noopener">
                    {{ task.trackerStatus }}
                    {{ ux_icon('lucide:external-link', {class: 'pablo-icon pablo-icon-dim'}) }}
                </a>
            {% else %}
                <span class="tag pablo-chip">{{ task.trackerStatus }}</span>
            {% endif %}
        {% else %}
            <span class="has-text-grey-light">—</span>
        {% endif %}
    </td>

    <td class="pablo-nowrap pablo-cell-pr"><twig:PrTag :pr="task.pr" :url="task.prUrl" /></td>

    <td class="pablo-nowrap pablo-cell-since has-text-grey" title="entered {{ task.stateEnteredAt|date('Y-m-d H:i') }}">{{ task.since }}</td>

    <td class="pablo-nowrap pablo-cell-actions">
        {% set event = constant('Pablo\\Twig\\Components\\TaskActionsModal::OPEN_EVENT') %}
        <div class="buttons are-small pablo-row-actions">
            <a class="button" href="{{ path('analytics_task', {project: task.project, branch: task.branch}) }}"
               title="Task history" aria-label="Task history of {{ task.project }}/{{ task.branch }}">
                {{ ux_icon('lucide:history', {class: 'pablo-icon'}) }}
            </a>
            {% if task.state.value == 'ci-red' %}
                <button type="button" class="button is-warning is-light"
                        title="Ignore failing CI checks"
                        data-action="live#emit"
                        data-live-event-param="{{ event }}"
                        data-live-mode-param="{{ constant('Pablo\\Twig\\Components\\TaskActionsModal::MODE_SKIP_CI') }}"
                        data-live-project-param="{{ task.project }}"
                        data-live-branch-param="{{ task.branch }}"
                        data-live-state-param="{{ task.state.value }}">
                    {{ ux_icon('lucide:ban', {class: 'pablo-icon'}) }}
                    <span>Skip CI</span>
                </button>
            {% endif %}
            <button type="button" class="button"
                    title="Force a state"
                    data-action="live#emit"
                    data-live-event-param="{{ event }}"
                    data-live-mode-param="{{ constant('Pablo\\Twig\\Components\\TaskActionsModal::MODE_FORCE_STATE') }}"
                    data-live-project-param="{{ task.project }}"
                    data-live-branch-param="{{ task.branch }}"
                    data-live-state-param="{{ task.state.value }}">
                {{ ux_icon('lucide:repeat', {class: 'pablo-icon'}) }}
                <span>Force state</span>
            </button>
            {% if task.state.value == 'closed' %}
                <button type="button" class="button is-danger"
                        title="Remove the worktree, the local branch and the task from PABLO"
                        data-action="live#emit"
                        data-live-event-param="{{ event }}"
                        data-live-mode-param="{{ constant('Pablo\\Twig\\Components\\TaskActionsModal::MODE_CLOSE_TASK') }}"
                        data-live-project-param="{{ task.project }}"
                        data-live-branch-param="{{ task.branch }}"
                        data-live-state-param="{{ task.state.value }}">
                    {{ ux_icon('lucide:trash-2', {class: 'pablo-icon'}) }}
                    <span>Close the task</span>
                </button>
            {% endif %}
        </div>
    </td>
</tr>
