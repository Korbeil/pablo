{# @var this \Pablo\Twig\Components\NewTaskModal #}
<div {{ attributes }}>
    <button type="button"
            class="button is-primary"
            data-action="live#action"
            data-live-action-param="open"
            data-loading="addClass(is-loading)"
            aria-label="New task">
        {{ ux_icon('lucide:plus', {class: 'pablo-icon'}) }}
        <span class="pablo-btn-label-narrow">New task</span>
    </button>

    {# Outside the modal: a successful start closes it, so the message must survive that. #}
    {% if this.message and not this.open %}
        <div class="notification is-success is-light pablo-new-task-flash">
            <button class="delete" aria-label="dismiss"
                    data-action="live#action"
                    data-live-action-param="dismiss"></button>
            {{ ux_icon('lucide:check', {class: 'pablo-icon'}) }}
            {{ this.message }}
        </div>
    {% endif %}

    {# Escape closes it (modal_controller clicks the backdrop's close action). #}
    <div class="modal {{ this.open ? 'is-active' : '' }}"
         data-controller="modal"
         data-action="keydown.esc@window->modal#close">
        {# A <div> has no default Stimulus event: "click->" is required. #}
        <div class="modal-background" data-modal-target="backdrop"
             data-action="click->live#action"
             data-live-action-param="close"></div>

        <div class="modal-card pablo-modal">
            <header class="modal-card-head">
                <p class="modal-card-title">
                    {{ ux_icon('lucide:plus', {class: 'pablo-icon'}) }}
                    New task
                </p>
                <button class="delete" aria-label="close"
                        data-action="live#action"
                        data-live-action-param="close"></button>
            </header>

            <section class="modal-card-body">
                <div class="tabs is-toggle is-small">
                    <ul>
                        <li class="{{ 'prompt' != this.mode ? 'is-active' : '' }}">
                            <a data-action="live#action"
                               data-live-action-param="useIssueMode">
                                {{ ux_icon('lucide:link', {class: 'pablo-icon'}) }}
                                <span>Issue link</span>
                            </a>
                        </li>
                        <li class="{{ 'prompt' == this.mode ? 'is-active' : '' }}">
                            <a data-action="live#action"
                               data-live-action-param="usePromptMode">
                                {{ ux_icon('lucide:pen-line', {class: 'pablo-icon'}) }}
                                <span>Prompt</span>
                            </a>
                        </li>
                    </ul>
                </div>

                {% if this.error %}
                    <div class="notification is-danger is-light">
                        {{ ux_icon('lucide:triangle-alert', {class: 'pablo-icon'}) }}
                        {{ this.error }}
                    </div>
                {% endif %}

                {% if 'issue' == this.mode %}
                    <div class="field">
                        <label class="label">Issue URL or key</label>
                        <div class="control">
                            <input class="input"
                                   type="text"
                                   name="text"
                                   placeholder="https://github.com/…/issues/123 or ABC-123"
                                   value="{{ this.text }}"
                                   data-model="text">
                        </div>
                        <p class="help">No project needed — PABLO scans every configured project.</p>
                    </div>
                {% else %}
                    <div class="field">
                        <label class="label">Project</label>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select name="project" data-model="project">
                                    <option value="">— pick a project —</option>
                                    {% for type, names in this.projectChoices %}
                                        <optgroup label="{{ type }}">
                                            {% for name in names %}
                                                <option value="{{ name }}" {{ this.project == name ? 'selected' : '' }}>{{ name }}</option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Prompt</label>
                        <div class="control">
                            <textarea class="textarea"
                                      name="text"
                                      rows="6"
                                      placeholder="Describe what PABLO should work on…"
                                      data-model="text">{{ this.text }}</textarea>
                        </div>
                        <p class="help">The branch name comes from an AI summary of the prompt; task-analyst starts right after creation, so this can take a moment.</p>
                    </div>
                {% endif %}
            </section>

            <footer class="modal-card-foot">
                <button class="button is-primary"
                        data-action="live#action"
                        data-live-action-param="start"
                        data-loading="addClass(is-loading)">
                    {{ ux_icon('lucide:rocket', {class: 'pablo-icon'}) }}
                    <span>Start task</span>
                </button>
            </footer>
        </div>
    </div>
</div>
