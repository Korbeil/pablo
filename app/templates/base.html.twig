<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}PABLO{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/pablo.png') }}">
    <script>
        (function () {
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (tz && document.cookie.indexOf('pablo_tz=') === -1) {
                document.cookie = 'pablo_tz=' + encodeURIComponent(tz) + ';path=/;max-age=31536000';
            }
        })();
    </script>
    {# Theme bootstrap: must run before first paint. A stored choice sets
       data-theme on <html>; anything else (absent, 'system', storage blocked)
       leaves the attribute off so Bulma follows prefers-color-scheme. #}
    <script>
        try {
            var theme = localStorage.getItem('pablo-theme');
            if (theme === 'light' || theme === 'dark') {
                document.documentElement.dataset.theme = theme;
            }
        } catch (e) {}
    </script>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
