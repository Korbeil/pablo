{% extends 'base.html.twig' %}

{% block title %}PABLO analytics{% endblock %}

{% block body %}
    <header class="pablo-header">
        <div class="pablo-container pablo-header-inner">
            <a class="pablo-brand" href="{{ path('dashboard') }}">
                <img class="pablo-logo" src="{{ asset('images/logo-light.svg') }}" alt="PABLO" width="125" height="42">
                <span class="pablo-page-tag">Analytics</span>
            </a>
            <h1 class="pablo-visually-hidden">P.A.B.L.O. analytics — task lifetimes, agent runs, tokens &amp; cost</h1>
            <div class="pablo-header-actions">
                <twig:ThemeToggle />
                <a class="button pablo-header-btn" href="{{ path('dashboard') }}" title="Task board" aria-label="Task board">
                    {{ ux_icon('lucide:arrow-left', {class: 'pablo-icon'}) }}
                    <span class="pablo-btn-label">Task board</span>
                </a>
            </div>
        </div>
    </header>

    <main class="pablo-container">
        {% if not has_events %}
            <section class="pablo-section">
                <h2 class="pablo-heading">
                    {{ ux_icon('lucide:chart-column', {class: 'pablo-icon'}) }}
                    Analytics
                </h2>
                {% if has_any_events %}
                    <p class="pablo-empty">No analytics events match this filter.</p>
                {% else %}
                    <p class="pablo-empty">No analytics events recorded yet — start a task and the log will fill up.</p>
                {% endif %}
            </section>
        {% else %}
            <nav class="tabs is-boxed pablo-tabs" aria-label="Filter by project type">
                <ul>
                    {% for t in type_choices %}
                        <li class="{{ active_type == t ? 'is-active' : '' }}">
                            <a href="{{ path('analytics', {days: active_days, type: t, by: active_by}) }}">{{ t == '' ? 'All' : t|capitalize }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <nav class="tabs is-boxed pablo-tabs" aria-label="Time range">
                <ul>
                    {% for choice in day_choices %}
                        <li class="{{ active_days == choice ? 'is-active' : '' }}">
                            <a href="{{ path('analytics', {days: choice, type: active_type, by: active_by}) }}">{{ choice == 'all' ? 'All time' : choice ~ 'd' }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <div class="pablo-kpis">
                {% for label, value in kpis %}
                    <div class="pablo-kpi">
                        <span class="pablo-kpi-value">{{ value }}</span>
                        <span class="pablo-kpi-label">{{ label }}</span>
                    </div>
                {% endfor %}
            </div>

            {% if throughput %}
                <section class="pablo-section pablo-chart-card">
                    <h2 class="pablo-heading">
                        {{ ux_icon('lucide:git-branch', {class: 'pablo-icon'}) }}
                        Tasks opened vs closed
                    </h2>
                    <div class="pablo-chart-box">{{ render_chart(throughput) }}</div>
                </section>
            {% endif %}

            <section class="pablo-section" id="breakdown" aria-labelledby="breakdown-heading">
                <h2 class="pablo-heading" id="breakdown-heading">
                    {{ ux_icon('lucide:list', {class: 'pablo-icon'}) }}
                    Agent runs by {{ active_by }}
                </h2>
                <nav class="tabs is-boxed pablo-tabs" aria-label="Break agent runs down by">
                    <ul>
                        {% for choice in by_choices %}
                            <li class="{{ active_by == choice ? 'is-active' : '' }}">
                                <a href="{{ path('analytics', {days: active_days, type: active_type, by: choice, _fragment: 'breakdown'}) }}"{% if active_by == choice %} aria-current="page"{% endif %}>{{ choice|capitalize }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
                {% if breakdown is empty %}
                    <p class="pablo-empty">No finished agent runs in this window.</p>
                {% else %}
                    <div class="pablo-chart-card pablo-breakdown-chart">
                        <div class="pablo-chart-box" role="img" aria-label="Tokens per {{ active_by }}, top {{ constant('Pablo\\Dashboard\\AnalyticsCharts::TOP') }}, stacked by input, output, cache read and cache write">{{ render_chart(breakdown_chart) }}</div>
                    </div>
                    <div class="table-container pablo-card">
                        <table class="table is-fullwidth is-hoverable pablo-table pablo-breakdown-table">
                            <caption class="pablo-visually-hidden">Finished agent runs by {{ active_by }}, most tokens first</caption>
                            <thead>
                            <tr>
                                <th scope="col">{{ active_by|capitalize }}</th>
                                <th scope="col" class="has-text-right">Runs</th>
                                <th scope="col" class="has-text-right">Time</th>
                                <th scope="col" class="has-text-right">Avg time</th>
                                <th scope="col" class="has-text-right">In</th>
                                <th scope="col" class="has-text-right">Out</th>
                                <th scope="col" class="has-text-right">Cache R</th>
                                <th scope="col" class="has-text-right">Cache W</th>
                                <th scope="col" class="has-text-right" aria-sort="descending">Total</th>
                                <th scope="col" class="has-text-right">Cost</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for group, row in breakdown %}
                                <tr>
                                    <th scope="row" class="pablo-breakdown-group">
                                        {% if active_by == 'task' %}
                                            {% set parts = group|split('/', 2) %}
                                            <a href="{{ path('analytics_task', {project: parts[0], branch: parts[1] ?? ''}) }}">{{ group }}</a>
                                        {% else %}
                                            {{ group }}
                                        {% endif %}
                                    </th>
                                    <td class="pablo-num">{{ row.runs }}</td>
                                    <td class="pablo-num">{{ row.duration_s|pablo_duration(true) }}</td>
                                    <td class="pablo-num">{{ row.avg_run_s|pablo_duration }}</td>
                                    <td class="pablo-num">{{ row.tokens_in|pablo_tokens }}</td>
                                    <td class="pablo-num">{{ row.tokens_out|pablo_tokens }}</td>
                                    <td class="pablo-num">{{ row.cache_read|pablo_tokens }}</td>
                                    <td class="pablo-num">{{ row.cache_write|pablo_tokens }}</td>
                                    <td class="pablo-num"><strong>{{ row.tokens_total|pablo_tokens }}</strong></td>
                                    <td class="pablo-num">{{ row.cost|pablo_cost }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if breakdown_hidden > 0 %}
                        <p class="pablo-note has-text-grey">{{ breakdown_hidden }} more group(s) with fewer tokens not shown — <code>pablo stats --by={{ active_by }} --limit=0</code> lists them all.</p>
                    {% endif %}
                {% endif %}
            </section>

            <div class="pablo-grid">
                <section class="pablo-section pablo-chart-card" aria-labelledby="top-tasks-heading">
                    <h2 class="pablo-heading" id="top-tasks-heading">
                        {{ ux_icon('lucide:git-branch', {class: 'pablo-icon'}) }}
                        Top tasks by tokens
                    </h2>
                    {% if top_tasks is empty %}
                        <p class="pablo-empty">No finished agent runs in this window.</p>
                    {% else %}
                        <div class="table-container">
                            <table class="table is-fullwidth is-hoverable pablo-table pablo-top-tasks">
                                <thead>
                                <tr>
                                    <th scope="col">Task</th>
                                    <th scope="col" class="has-text-right">Runs</th>
                                    <th scope="col" class="has-text-right">Tokens</th>
                                    <th scope="col" class="has-text-right">Cost</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for t in top_tasks %}
                                    <tr>
                                        <th scope="row">
                                            <a href="{{ path('analytics_task', {project: t.project, branch: t.branch}) }}" title="History of {{ t.project }}/{{ t.branch }}">
                                                <span class="has-text-grey">{{ t.project }}/</span><code>{{ t.branch }}</code>
                                            </a>
                                        </th>
                                        <td class="pablo-num">{{ t.runs }}</td>
                                        <td class="pablo-num">{{ t.tokens_total|pablo_tokens }}</td>
                                        <td class="pablo-num">{{ t.cost|pablo_cost }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </section>

                <section class="pablo-section pablo-chart-card" aria-labelledby="models-heading">
                    <h2 class="pablo-heading" id="models-heading">
                        {{ ux_icon('lucide:cpu', {class: 'pablo-icon'}) }}
                        Tokens &amp; cost per model
                    </h2>
                    {% if model_chart %}
                        <div class="pablo-chart-box" role="img" aria-label="Total tokens per model, with cost where the runtime reported one">{{ render_chart(model_chart) }}</div>
                    {% else %}
                        <p class="pablo-empty">No finished agent runs in this window.</p>
                    {% endif %}
                </section>

                {% if tokens %}
                    <section class="pablo-section pablo-chart-card">
                        <h2 class="pablo-heading">
                            {{ ux_icon('lucide:coins', {class: 'pablo-icon'}) }}
                            Tokens per agent
                        </h2>
                        <div class="pablo-chart-box">{{ render_chart(tokens) }}</div>
                    </section>
                {% endif %}

                {% if cache_hit %}
                    <section class="pablo-section pablo-chart-card">
                        <h2 class="pablo-heading">
                            {{ ux_icon('lucide:zap', {class: 'pablo-icon'}) }}
                            Cache hit %
                        </h2>
                        <div class="pablo-chart-box">{{ render_chart(cache_hit) }}</div>
                    </section>
                {% endif %}

                {% if runtime %}
                    <section class="pablo-section pablo-chart-card">
                        <h2 class="pablo-heading">
                            {{ ux_icon('lucide:timer', {class: 'pablo-icon'}) }}
                            Avg runtime per agent
                        </h2>
                        <div class="pablo-chart-box">{{ render_chart(runtime) }}</div>
                    </section>
                {% endif %}

                {% if cost_chart %}
                    <section class="pablo-section pablo-chart-card">
                        <h2 class="pablo-heading">
                            {{ ux_icon('lucide:dollar-sign', {class: 'pablo-icon'}) }}
                            Cost per agent
                        </h2>
                        <div class="pablo-chart-box">{{ render_chart(cost_chart) }}</div>
                    </section>
                {% endif %}

                {% if dwell %}
                    <section class="pablo-section pablo-chart-card">
                        <h2 class="pablo-heading">
                            {{ ux_icon('lucide:repeat', {class: 'pablo-icon'}) }}
                            State dwell &amp; entries (rework loops)
                        </h2>
                        <div class="pablo-chart-box">{{ render_chart(dwell) }}</div>
                    </section>
                {% endif %}
            </div>
        {% endif %}
    </main>
{% endblock %}
