# Binary builds (castor build:binary, box compile): dist/pablo.phar, dist/pablo, dist/stage/.
dist/
*.swp

# php stuff. `vendor/` is anchored on purpose: an unanchored pattern also
# matches app/assets/vendor/, where AssetMapper vendors the dashboard's JS —
# and neither an install nor the binary build runs `importmap:install`, so
# those files must be committed or the dashboard has no JavaScript.
/app/vendor/
!/app/assets/vendor/
.phpunit.result.cache
.castor.stub.php

# Castor remote packages + QA caches
.castor/
app/var/
.twig-cs-fixer.cache

# Regenerated by Symfony on every cache warm (IDE autocompletion for config()).
app/config/reference.php

# Legacy: the clone install (bin/install.sh) rendered the agents into the
# checkout. They are now rendered into ~/.pablo/runtime; these stay ignored so
# leftovers in an older checkout are never committed (delete them freely).
/opencode/agents/task-analyst.md
/opencode/agents/task-feedback.md
/opencode/agents/ci-analyst.md
/opencode/agents/pr-feedback.md
/opencode/agents/rebase-conflict-resolver.md
/claude/
/copilot/

# Compiled dashboard assets (asset-map:compile, binary builds only): their
# presence would shadow the dev AssetMapper in a checkout.
/app/public/assets/

# A `gh` invocation that inherits no HOME writes its state next to the cwd.
app/.local/

# Website build (site/build): its Composer deps and the generated site.
/site/build/vendor/
/_site/
