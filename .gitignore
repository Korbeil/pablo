__pycache__/
.pytest_cache/
dist/
.venv/
*.swp
*.pyc

# Project configs are per-machine/personal; only the shared defaults are committed.
app/projects/*.yaml
!app/projects/default.yaml

# php stuff. `vendor/` is anchored on purpose: an unanchored pattern also
# matches app/assets/vendor/, where AssetMapper vendors the dashboard's JS —
# and install.sh never runs `importmap:install`, so those files must be
# committed or a fresh clone gets a dashboard with no JavaScript.
/app/vendor/
!/app/assets/vendor/
.phpunit.result.cache
.castor.stub.php

# Castor remote packages + QA caches
.castor/
app/var/
.twig-cs-fixer.cache

# Regenerated by Symfony on every cache warm (IDE autocompletion for config()).
app/config/reference.php

# A `gh` invocation that inherits no HOME writes its state next to the cwd.
app/.local/
