# Written by `pablo system:install` into ~/.config/systemd/user — do not edit
# there, a re-install overwrites it.
# marker: pablo-dispatch.timer (system:uninstall removes only files carrying this line)
[Unit]
Description=Run the PABLO dispatcher every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
