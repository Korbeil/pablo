# Written by `pablo system:install` into ~/.config/systemd/user — do not edit
# there, a re-install overwrites it.
# marker: pablo-dispatch.timer (system:uninstall removes only files carrying this line)
[Unit]
Description=Run the PABLO dispatcher every @TICK_MINUTES@ minute(s)

[Timer]
# dispatch.tick_minutes in ~/.pablo/config.yaml (default 1), written here by
# `pablo system:install`. Each project's intervals are enforced by the
# dispatcher itself; this is only how often it looks.
OnCalendar=*:0/@TICK_MINUTES@
# systemd's default accuracy (1min) would let a tick fire up to a minute late.
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
