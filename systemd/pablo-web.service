# Written by `pablo system:install` into ~/.config/systemd/user — do not edit
# there, a re-install overwrites it.
# marker: pablo-web.service (system:uninstall removes only files carrying this line)
[Unit]
Description=PABLO read-only dashboard (127.0.0.1)

[Service]
Type=simple
# Same PATH as pablo-dispatch.service (computed by `pablo system:install`):
# kept for parity, so any CLI the dashboard reaches resolves the same way.
Environment="PATH=@PATH@"
# acli requires DBUS_SESSION_BUS_ADDRESS (see pablo-dispatch.service); set it
# here too so any acli path keeps working under this unit.
Environment=DBUS_SESSION_BUS_ADDRESS=disabled:
ExecStart=%h/.local/bin/pablo web
# The dashboard is long-running: self-heal if the server exits. A plain
# `systemctl --user stop` still stops it (SIGTERM to the server, which stops
# its workers; default KillMode=control-group takes down any straggler).
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
