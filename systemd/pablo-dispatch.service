[Unit]
Description=PABLO background dispatcher (worktree sync + task-state polling)

[Service]
Type=oneshot
# systemd --user's default PATH omits the Orca CLI shim dir, so a bare
# `orca` lookup resolves to the unrelated /usr/bin/orca (GNOME screen
# reader) instead — it then hangs reaching for the desktop until Pablo's
# 30s probe timeout, which is why every agent silently fell back to
# headless and never showed up in the Orca UI. Put the shim dir first.
# openchamber (pnpm global bin) is also here so the poller's agent-status
# query (`openchamber session list`) resolves under this unit — otherwise
# every pass silently blanks agent status from the dashboard cache. The
# pnpm shim is a shell wrapper that then needs `node`, which lives in the
# nvm install dir; add it too so the shim's `command -v node` resolves.
Environment=PATH=%h/.config/orca/linux-orca-cli-shim:%h/.opencode/bin:%h/.local/bin:%h/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:%h/.local/share/pnpm/bin:%h/.nvm/versions/node/v24.19.0/bin
# acli (the Jira CLI) requires DBUS_SESSION_BUS_ADDRESS: without it the JVM
# blocks waiting for a session bus and every acli call times out after 30s,
# so the poller writes '?' tracker statuses. Use the same "disabled" value the
# interactive shell already exports (this is a headless box — /run/user/<uid>
# may hold a socket with no daemon behind it, which hangs acli instead).
Environment=DBUS_SESSION_BUS_ADDRESS=disabled:
ExecStart=%h/.local/bin/pablo system:dispatch
# Headless-fallback agents (Agents.php's opencode subprocess, detached via
# start_new_session) stay in this unit's cgroup even though they escape its
# process group/session. Default KillMode=control-group would SIGKILL them
# the moment this oneshot run exits — KillMode=process scopes the kill to
# the tracked ExecStart process only, letting orphaned agents keep running.
KillMode=process
# Backstop: a wedged run must never block future timer fires forever.
TimeoutStartSec=10min
