[Unit]
Description=PABLO background dispatcher (worktree sync + task-state polling)
Documentation=file://%h/Sites/korbeil/pablo/README.md

[Service]
Type=oneshot
# systemd --user's default PATH omits the Orca CLI shim dir, so a bare
# `orca` lookup resolves to the unrelated /usr/bin/orca (GNOME screen
# reader) instead — it then hangs reaching for the desktop until Pablo's
# 30s probe timeout, which is why every agent silently fell back to
# headless and never showed up in the Orca UI. Put the shim dir first.
Environment=PATH=%h/.config/orca/linux-orca-cli-shim:%h/.opencode/bin:%h/.local/bin:%h/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin
ExecStart=%h/.local/bin/pablo system:dispatch
# Headless-fallback agents (agents.py's opencode subprocess, detached via
# start_new_session) stay in this unit's cgroup even though they escape its
# process group/session. Default KillMode=control-group would SIGKILL them
# the moment this oneshot run exits — KillMode=process scopes the kill to
# the tracked ExecStart process only, letting orphaned agents keep running.
KillMode=process
# Backstop: a wedged run must never block future timer fires forever.
TimeoutStartSec=10min
