#!/usr/bin/env bash
# PABLO installer (Linux + macOS), served at https://getpablo.dev/installer:
#
#   curl -fsSL https://getpablo.dev/installer | bash
#   curl -fsSL https://getpablo.dev/installer | bash -s -- --runtime claude-code --backend orca
#
# PABLO is a single binary: no PHP, no Composer. This script detects the agent
# runtimes (OpenCode, Claude Code, GitHub Copilot CLI) and the agent
# development environments (Orca, OpenChamber) that are installed, asks which
# ones to use, downloads pablo-<os>-<arch> from the latest GitHub Release (or
# --version), checks it against the release's sha256sums.txt, installs it as
# ~/.local/bin/pablo, then hands over to `pablo system:install`.
#
# Run it again to update (or run `pablo update`). An install made from a clone of the repository
# (a ~/.local/bin/pablo shim running `php …/app/bin/pablo`) is migrated: the
# shim is replaced by the binary and system:install moves the links over to
# ~/.pablo/runtime; the clone itself is left alone.
#
# Written for bash 3.2 (macOS): no associative arrays, mapfile or ${var,,}.
set -euo pipefail

PABLO_RELEASES_URL="${PABLO_RELEASES_URL:-https://github.com/Korbeil/pablo/releases}"
PREREQUISITES_URL="https://getpablo.dev/docs/installation/#prerequisites"
BIN_DIR="${HOME}/.local/bin"
BIN="${BIN_DIR}/pablo"
# The dashboard's port when ~/.pablo/config.yaml sets none (PABLO_INSTALLER_DEFAULT_PORT: tests).
DEFAULT_PORT="${PABLO_INSTALLER_DEFAULT_PORT:-8321}"

# Where the answers are read from. With `curl | bash` stdin is the script
# itself, so questions go through the terminal. PABLO_INSTALLER_TTY lets the
# test suite feed answers from a file.
TTY_IN="${PABLO_INSTALLER_TTY:-/dev/tty}"
INTERACTIVE=false
ANSWER=""
CHOICE=""

COLORS=false
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    COLORS=true
fi

output() { # output <text> [success|error|warning|heading|muted]
    local start="" end=""
    if $COLORS; then
        case "${2:-}" in
        success) start='\033[0;32m' end='\033[0m' ;;
        error) start='\033[31m' end='\033[0m' ;;
        warning) start='\033[33m' end='\033[0m' ;;
        heading) start='\033[1;33m' end='\033[22;39m' ;;
        muted) start='\033[2m' end='\033[0m' ;;
        esac
    fi
    printf '%b%b%b\n' "$start" "$1" "$end"
}

ok() { output "  [*] $1" success; }
warn() { output "  [!] $1" warning; }
bad() { output "  [ ] $1" error; }
fail() {
    output "\n$1" error >&2
    exit 1
}

has_word() { # has_word "<space separated list>" <word>
    case " $1 " in
    *" $2 "*) return 0 ;;
    *) return 1 ;;
    esac
}

runtime_command() {
    case "$1" in
    opencode) echo opencode ;;
    claude-code) echo claude ;;
    copilot) echo copilot ;;
    esac
}

runtime_label() {
    case "$1" in
    opencode) echo "OpenCode" ;;
    claude-code) echo "Claude Code" ;;
    copilot) echo "GitHub Copilot CLI" ;;
    esac
}

backend_label() {
    case "$1" in
    orca) echo "Orca" ;;
    openchamber) echo "OpenChamber" ;;
    headless) echo "none (agents run headless in the background)" ;;
    esac
}

usage() {
    cat <<'USAGE'
Usage: installer [options]

  --version <release>   release to install, by name (the short commit hash,
                        e.g. 5b34e92; default: the latest)
  --runtime <name>      opencode, claude-code or copilot
  --backend <name>      orca, openchamber or headless (OpenChamber: OpenCode only)
  --without-web         do not install the dashboard service
  --port <port>         port of the dashboard (default: 8321, or the next free
                        one when another program uses it)
  --no-interaction      never ask: use the options, then what is detected
  -h, --help            show this help

Without --runtime / --backend, the installer detects what is installed and asks.
Run it again to update PABLO.
USAGE
}

# Questions -------------------------------------------------------------------

setup_interaction() {
    if [ "$NO_INTERACTION" = true ]; then
        return 0
    fi
    # `: <` first: /dev/tty exists as a file even without a terminal, and a
    # failing `exec` redirection would end the whole script.
    if (: <"$TTY_IN") 2>/dev/null; then
        exec 3<"$TTY_IN"
        INTERACTIVE=true
    fi
}

read_answer() { # sets ANSWER; empty at end of input
    ANSWER=""
    IFS= read -r ANSWER <&3 || ANSWER=""
}

ask_choice() { # ask_choice <title> <default-value> <value|label>...  -> CHOICE
    local title="$1" default="$2" opt i default_idx=1 n
    shift 2
    n=$#
    i=1
    for opt in "$@"; do
        if [ "${opt%%|*}" = "$default" ]; then
            default_idx=$i
        fi
        i=$((i + 1))
    done
    while true; do
        output "\n$title" heading
        i=1
        for opt in "$@"; do
            printf '  %s) %s\n' "$i" "${opt#*|}"
            i=$((i + 1))
        done
        printf 'Your choice [%s]: ' "$default_idx"
        read_answer
        if [ -z "$ANSWER" ]; then
            ANSWER="$default_idx"
        fi
        if [[ "$ANSWER" =~ ^[0-9]+$ ]] && [ "$ANSWER" -ge 1 ] && [ "$ANSWER" -le "$n" ]; then
            i=1
            for opt in "$@"; do
                if [ "$i" -eq "$ANSWER" ]; then
                    CHOICE="${opt%%|*}"
                fi
                i=$((i + 1))
            done
            return 0
        fi
        warn "Answer with a number between 1 and $n."
    done
}

ask_text() { # ask_text <question> <default>  -> ANSWER
    printf '\n%s [%s]: ' "$1" "$2"
    read_answer
    if [ -z "$ANSWER" ]; then
        ANSWER="$2"
    fi
}

ask_yes_no() { # ask_yes_no <question> <y|n>  -> status 0 for yes
    local default="$2" hint="[Y/n]"
    if [ "$default" = n ]; then
        hint="[y/N]"
    fi
    while true; do
        printf '\n%s %s: ' "$1" "$hint"
        read_answer
        case "$ANSWER" in
        "") ANSWER="$default" ;;
        esac
        case "$ANSWER" in
        y | Y | yes | YES | Yes) return 0 ;;
        n | N | no | NO | No) return 1 ;;
        esac
        warn "Answer with y or n."
    done
}

# Detection -------------------------------------------------------------------

config_value() { # config_value <key>: a top-level key of an existing ~/.pablo/config.yaml
    local file="${PABLO_CONFIG:-$HOME/.pablo/config.yaml}"
    if [ -f "$file" ]; then
        sed -n "s/^$1:[[:space:]]*[\"']\{0,1\}\([^\"'#[:space:]]*\).*\$/\1/p" "$file" | head -n 1
    fi
}

# What a `pablo` command is: "shim <checkout>" (the clone install's php shim),
# "pablo <version>" (a PABLO binary) or "foreign".
classify_pablo() { # classify_pablo <path>
    local target="" version=""
    # The clone install's shim: exec php '<checkout>/app/bin/pablo' "$@"
    if [ -f "$1" ]; then
        target="$(sed -n "s/^exec php '\(.*\)' .*\$/\1/p" "$1" 2>/dev/null | head -n 1)"
    fi
    case "$target" in
    */app/bin/pablo)
        echo "shim ${target%/app/bin/pablo}"
        return 0
        ;;
    esac
    version="$("$1" --version 2>/dev/null | head -n 1 || true)"
    case "$version" in
    "pablo "*) echo "$version" ;;
    *) echo foreign ;;
    esac
}

not_pablo() { # not_pablo <path>
    output "\nA pablo command already exists at $1 and is not PABLO." error >&2
    output "  Move it out of the way, then run this installer again." >&2
    exit 1
}

# What is already there, in ~/.local/bin (where this installs) and on the
# PATH: nothing, a clone install to migrate (CHECKOUT set), a PABLO binary to
# update (CURRENT set), or a foreign `pablo` (stop). Another PABLO elsewhere on
# the PATH is only warned about: it would shadow, or be shadowed by, this one.
detect_existing() {
    local kind="" on_path=""
    CHECKOUT=""
    CURRENT=""

    if [ -e "$BIN" ]; then
        kind="$(classify_pablo "$BIN")"
        case "$kind" in
        "shim "*)
            CHECKOUT="${kind#shim }"
            output "\nPABLO is installed from a checkout in $CHECKOUT (command: $BIN)."
            output "  It will be replaced by the standalone binary; the checkout itself is left alone."
            ;;
        "pablo "*)
            CURRENT="$kind"
            output "\n${CURRENT#pablo } is installed in $BIN: it will be updated."
            ;;
        *) not_pablo "$BIN" ;;
        esac
    fi

    on_path="$(command -v pablo 2>/dev/null || true)"
    if [ -z "$on_path" ] || [ "$on_path" = "$BIN" ]; then
        return 0
    fi
    kind="$(classify_pablo "$on_path")"
    case "$kind" in
    "shim "* | "pablo "*)
        warn "Another PABLO is on your PATH at $on_path (${kind}): remove it, or \`pablo\` may not run the one installed in $BIN."
        if [ -z "$CHECKOUT" ] && [ "${kind%% *}" = shim ]; then
            CHECKOUT="${kind#shim }"
        fi
        ;;
    *) not_pablo "$on_path" ;;
    esac
}

check_environment() {
    local failed=false arch
    output "\nEnvironment check" heading

    kernel="$(uname -s 2>/dev/null || /usr/bin/uname -s)"
    arch="$(uname -m 2>/dev/null || /usr/bin/uname -m)"
    case "$kernel" in
    Linux | linux) OS=linux ;;
    Darwin | darwin) OS=macos ;;
    *) fail "OS '$kernel' is not supported (Linux and macOS are)." ;;
    esac
    case "$OS-$arch" in
    linux-x86_64 | linux-amd64) TARGET=linux-x86_64 ;;
    linux-aarch64 | linux-arm64) TARGET=linux-aarch64 ;;
    macos-arm64 | macos-aarch64) TARGET=macos-arm64 ;;
    macos-x86_64) TARGET=macos-x86_64 ;;
    *) fail "No PABLO binary for $kernel on $arch (supported: Linux x86_64/aarch64, macOS arm64/x86_64)." ;;
    esac
    ok "$kernel $arch"

    if command -v git >/dev/null 2>&1; then
        ok "git is installed"
    else
        bad "git is required: every task is a branch and a worktree"
        failed=true
    fi

    if command -v curl >/dev/null 2>&1; then
        ok "curl is installed"
    else
        bad "curl is required to download PABLO"
        failed=true
    fi

    if command -v sha256sum >/dev/null 2>&1; then
        SHA256="sha256sum"
    elif command -v shasum >/dev/null 2>&1; then
        SHA256="shasum -a 256"
    else
        bad "sha256sum or shasum is required to verify the download"
        failed=true
    fi

    if $failed; then
        fail "Some prerequisites are missing. See $PREREQUISITES_URL"
    fi
}

choose_runtime() {
    local found="" r default options
    options=()
    output "\nAgent runtimes" heading
    for r in opencode claude-code copilot; do
        if command -v "$(runtime_command "$r")" >/dev/null 2>&1; then
            found="$found $r"
            ok "$(runtime_label "$r") found ($(command -v "$(runtime_command "$r")"))"
        else
            output "  [ ] $(runtime_label "$r") not found" muted
        fi
    done

    if [ -n "$RUNTIME" ]; then
        if ! has_word "$found" "$RUNTIME"; then
            warn "$(runtime_label "$RUNTIME") was asked for but '$(runtime_command "$RUNTIME")' is not on your PATH"
        fi
        return 0
    fi

    if [ -z "$found" ]; then
        bad "No agent runtime found. PABLO needs one of OpenCode, Claude Code or GitHub Copilot CLI."
        fail "Install one of them, then run this installer again. See $PREREQUISITES_URL"
    fi

    default=""
    r="$(config_value agent_runtime)"
    if [ -n "$r" ] && has_word "$found" "$r"; then
        default="$r"
    else
        for r in $found; do
            default="$r"
            break
        done
    fi

    # One runtime only: nothing to ask. Several: ask when we can.
    # shellcheck disable=SC2086 # $found is a space separated list on purpose
    set -- $found
    if [ $# -eq 1 ] || ! $INTERACTIVE; then
        RUNTIME="$default"
        return 0
    fi
    for r in $found; do
        options+=("$r|$(runtime_label "$r")")
    done
    ask_choice "Which agent runtime should PABLO use?" "$default" "${options[@]}"
    RUNTIME="$CHOICE"
}

choose_backend() {
    local candidates="orca" found="" b default options
    options=()
    # OpenChamber drives its own OpenCode server: it only matches OpenCode.
    if [ "$RUNTIME" = opencode ]; then
        candidates="orca openchamber"
    fi

    output "\nAgent development environments" heading
    for b in orca openchamber; do
        if command -v "$b" >/dev/null 2>&1; then
            if has_word "$candidates" "$b"; then
                found="$found $b"
                ok "$(backend_label "$b") found ($(command -v "$b"))"
            else
                output "  [ ] $(backend_label "$b") found, but it cannot run $(runtime_label "$RUNTIME") (OpenCode only)" muted
            fi
        else
            output "  [ ] $(backend_label "$b") not found" muted
        fi
    done

    if [ -n "$BACKEND" ]; then
        if [ "$BACKEND" = openchamber ] && [ "$RUNTIME" != opencode ]; then
            fail "OpenChamber only works with OpenCode: --backend openchamber cannot run $(runtime_label "$RUNTIME")."
        fi
        if [ "$BACKEND" != headless ] && ! command -v "$BACKEND" >/dev/null 2>&1; then
            warn "$(backend_label "$BACKEND") was asked for but '$BACKEND' is not on your PATH"
        fi
        return 0
    fi

    if [ -z "$found" ]; then
        warn "No agent development environment found: agents can run headless in the background."
        warn "Install Orca or OpenChamber to read and chat with them. See $PREREQUISITES_URL"
        BACKEND=headless
        if $INTERACTIVE; then
            ask_choice "How should PABLO run the agents?" headless \
                "headless|$(backend_label headless)" \
                "quit|Stop here, I will install one first"
            if [ "$CHOICE" = quit ]; then
                fail "Aborted, nothing was installed. Install Orca or OpenChamber, then run this installer again. See $PREREQUISITES_URL"
            fi
        fi
        return 0
    fi

    default=""
    b="$(config_value agent_backend)"
    if [ -n "$b" ] && has_word "$found" "$b"; then
        default="$b"
    else
        for b in $found; do
            default="$b"
            break
        done
    fi

    if ! $INTERACTIVE; then
        BACKEND="$default"
        return 0
    fi
    for b in $found; do
        options+=("$b|$(backend_label "$b")")
    done
    options+=("headless|$(backend_label headless)")
    ask_choice "Which agent development environment should PABLO use?" "$default" "${options[@]}"
    BACKEND="$CHOICE"
}

# Dashboard port --------------------------------------------------------------

is_port() { # is_port <value>: a number between 1 and 65535
    case "$1" in
    "" | *[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

port_in_use() { # port_in_use <port>: something accepts connections on it
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

is_pablo_dashboard() { # is_pablo_dashboard <port>: PABLO's own dashboard answers there
    curl -fsS -m 3 "http://127.0.0.1:$1/" 2>/dev/null | grep -q '<meta name="application-name" content="PABLO">'
}

port_available() { # port_available <port>: free, or already PABLO's dashboard (a re-install)
    ! port_in_use "$1" || is_pablo_dashboard "$1"
}

next_free_port() { # next_free_port <from>
    local port="$1"
    while [ "$port" -le 65535 ]; do
        if ! port_in_use "$port"; then
            echo "$port"
            return 0
        fi
        port=$((port + 1))
    done
    return 1
}

# Sets PORT: --port as given, else the configured (or default) port when it is
# free or PABLO's own dashboard already uses it, else another one: the next
# free port, which the user can change.
choose_port() {
    local suggestion
    CONFIGURED_PORT="$(config_value dashboard_port)"
    CONFIGURED_PORT="${CONFIGURED_PORT:-$DEFAULT_PORT}"

    if [ -n "$PORT" ]; then
        if ! port_available "$PORT"; then
            warn "Port $PORT is already used by another program: the dashboard will not start until it is free."
        fi
        return 0
    fi

    if port_available "$CONFIGURED_PORT"; then
        PORT="$CONFIGURED_PORT"
        return 0
    fi

    suggestion="$(next_free_port $((CONFIGURED_PORT + 1)))" || fail "No free port found for the dashboard: pass one with --port."
    warn "Port $CONFIGURED_PORT is already used by another program."
    if ! $INTERACTIVE; then
        PORT="$suggestion"
        warn "The dashboard will use port $PORT instead (choose another with --port)."
        return 0
    fi
    while true; do
        ask_text "Which port should the dashboard use?" "$suggestion"
        if ! is_port "$ANSWER"; then
            warn "Answer with a port number between 1 and 65535."
        elif ! port_available "$ANSWER"; then
            warn "Port $ANSWER is already used by another program."
        else
            PORT="$ANSWER"
            return 0
        fi
    done
}

# Download --------------------------------------------------------------------

download() {
    local base asset tmp expected actual
    output "\nDownload" heading
    asset="pablo-$TARGET"
    if [ -n "$VERSION" ]; then
        base="$PABLO_RELEASES_URL/download/$VERSION"
    else
        base="$PABLO_RELEASES_URL/latest/download"
    fi

    # Downloaded next to its destination, so the final mv is an atomic rename
    # (from /tmp, often another filesystem, it would be a copy that a
    # scheduler tick could run half-written).
    mkdir -p "$BIN_DIR"
    tmp="$(mktemp -d "$BIN_DIR/.pablo-install.XXXXXX")"
    # shellcheck disable=SC2064 # expand $tmp now
    trap "rm -rf '$tmp'" EXIT

    output "  Downloading $base/$asset"
    curl -fsSL -o "$tmp/$asset" "$base/$asset" ||
        fail "Could not download $base/$asset${VERSION:+ (is $VERSION a PABLO release?)}"
    curl -fsSL -o "$tmp/sha256sums.txt" "$base/sha256sums.txt" ||
        fail "Could not download $base/sha256sums.txt"

    expected="$(awk -v a="$asset" '$2 == a || $2 == "*" a { print $1; exit }' "$tmp/sha256sums.txt")"
    [ -n "$expected" ] || fail "$asset is not listed in sha256sums.txt: refusing to install an unverified binary."
    actual="$($SHA256 "$tmp/$asset" | awk '{ print $1 }')"
    if [ "$actual" != "$expected" ]; then
        fail "Checksum mismatch for $asset (expected $expected, got $actual): nothing was installed."
    fi
    ok "sha256 verified"

    chmod +x "$tmp/$asset"
    # Replaces a clone install's shim, or the previous binary.
    mv -f "$tmp/$asset" "$BIN"
    ok "installed $BIN"
}

run_install() {
    output "\nInstall" heading
    set -- --runtime "$RUNTIME" --backend "$BACKEND"
    if ! $WITH_WEB; then
        set -- "$@" --without-web
    elif [ "$PORT" != "$CONFIGURED_PORT" ]; then
        set -- "$@" --port "$PORT"
    fi
    if ! "$BIN" system:install "$@" </dev/null; then
        fail "pablo system:install failed. Fix the error above, then run: $BIN system:install $*"
    fi
}

main() {
    output "PABLO installer" heading

    VERSION=""
    RUNTIME=""
    BACKEND=""
    WITH_WEB=true
    PORT=""
    CONFIGURED_PORT=""
    NO_INTERACTION=false

    while [ $# -gt 0 ]; do
        case "$1" in
        --version=*) VERSION="${1#*=}" ;;
        --version)
            [ $# -ge 2 ] || fail "--version needs a value"
            VERSION="$2"
            shift
            ;;
        --runtime=*) RUNTIME="${1#*=}" ;;
        --runtime)
            [ $# -ge 2 ] || fail "--runtime needs a value"
            RUNTIME="$2"
            shift
            ;;
        --backend=*) BACKEND="${1#*=}" ;;
        --backend)
            [ $# -ge 2 ] || fail "--backend needs a value"
            BACKEND="$2"
            shift
            ;;
        --port=*) PORT="${1#*=}" ;;
        --port)
            [ $# -ge 2 ] || fail "--port needs a value"
            PORT="$2"
            shift
            ;;
        --without-web) WITH_WEB=false ;;
        --with-web) WITH_WEB=true ;;
        --no-interaction | -n) NO_INTERACTION=true ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            fail "Unknown option $1"
            ;;
        esac
        shift
    done

    case "$RUNTIME" in
    "" | opencode | claude-code | copilot) ;;
    *) fail "Unknown --runtime '$RUNTIME' (expected opencode, claude-code or copilot)." ;;
    esac
    case "$BACKEND" in
    "" | orca | openchamber | headless) ;;
    *) fail "Unknown --backend '$BACKEND' (expected orca, openchamber or headless)." ;;
    esac
    if [ -n "$PORT" ] && ! is_port "$PORT"; then
        fail "Invalid --port '$PORT' (expected a number between 1 and 65535)."
    fi

    detect_existing
    setup_interaction
    check_environment
    choose_runtime
    choose_backend

    if $INTERACTIVE && $WITH_WEB; then
        if ! ask_yes_no "Install the dashboard service (a local web page on 127.0.0.1, restarts on its own)?" y; then
            WITH_WEB=false
        fi
    fi
    if $WITH_WEB; then
        choose_port
    fi

    output "\nSummary" heading
    output "  Version            ${VERSION:-latest}"
    output "  Binary             $BIN ($TARGET)"
    output "  Agent runtime      $(runtime_label "$RUNTIME")"
    output "  Agent environment  $(backend_label "$BACKEND")"
    if $WITH_WEB; then
        output "  Dashboard service  yes, on http://127.0.0.1:$PORT"
    else
        output "  Dashboard service  no"
    fi
    if $INTERACTIVE; then
        if ! ask_yes_no "Go ahead?" y; then
            fail "Aborted, nothing was installed."
        fi
    fi

    download
    run_install

    output "\nPABLO was installed successfully!" success
    output "  Command    $BIN"
    output "  Update     pablo update"
    output "  Uninstall  pablo system:uninstall"
    if [ -n "$CHECKOUT" ]; then
        output "  The checkout in $CHECKOUT is no longer used: delete it when you no longer need it."
    fi
}

# The whole script is read before anything runs: a truncated download
# (curl | bash) cannot execute a partial script.
main "$@"
